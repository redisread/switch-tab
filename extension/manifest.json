{
  "manifest_version": 3,
  "name": "Switch Tab — 最近标签切换",
  "version": "0.3.3",
  "description": "横向缩略图卡片切换最近标签。⌘X 选择，松开 ⌘ 确认。",
  "minimum_chrome_version": "127",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "storage",
    "favicon",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Switch Tab",
    "default_icon": {
      "16": "icon-16.png",
      "24": "icon-24.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "commands": {
    "switch-next": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Command+X"
      },
      "description": "选择下一个最近标签"
    },
    "switch-previous": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "反向选择最近标签"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "core.js",
        "ui.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
