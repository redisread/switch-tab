{
  "manifest_version": 3,
  "name": "Switch Tab — 最近标签切换",
  "version": "0.1.0",
  "description": "按最近使用顺序切换当前窗口的标签。Option+Q 选择，松开 Option 确认。",
  "minimum_chrome_version": "127",
  "incognito": "not_allowed",
  "permissions": ["tabs", "storage", "favicon"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Switch Tab" },
  "commands": {
    "switch-next": {
      "suggested_key": { "default": "Alt+Q", "mac": "Alt+Q" },
      "description": "选择下一个最近标签"
    },
    "switch-previous": {
      "suggested_key": { "default": "Alt+Shift+Q", "mac": "Alt+Shift+Q" },
      "description": "反向选择最近标签"
    }
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["core.js", "ui.js", "content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }],
  "web_accessible_resources": [{
    "resources": ["_favicon/*"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
